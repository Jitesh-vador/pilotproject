<mvc:View
    controllerName="com.hr.portal.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core">
    <Shell id="shell">
        <tnt:ToolPage
            id="toolPage"
            sideExpanded="{= ${roleModel>/isHR} === true || ${roleModel>/isEmployee} === true }">
            
            <tnt:header>
                <tnt:ToolHeader>
                    <Button
                        icon="sap-icon://menu2"
                        type="Transparent"
                        press="onSideNavButtonPress"
                        visible="{= ${roleModel>/isHR} === true || ${roleModel>/isEmployee} === true }"/>
                    <Title text="{i18n>appTitle}" level="H1"/>
                    <ToolbarSpacer/>
                    
                    <Select id="languageSelect" change="onChangeLanguage" autoAdjustWidth="true" icon="sap-icon://world" visible="{= ${roleModel>/isHR} === true || ${roleModel>/isEmployee} === true }">
                        <core:Item key="en" text="English" />
                        <core:Item key="de" text="Deutsch" />
                        <core:Item key="ru" text="Русский" />
                    </Select>

                    <Button
                        icon="sap-icon://bell"
                        type="Transparent"
                        press="onNotificationPress"
                        visible="{roleModel>/isHR}">
                        <customData>
                            <core:CustomData
                                key="badge"
                                value="3"
                                writeToDom="true"/>
                        </customData>
                    </Button>
                    <Avatar
                        src="https://randomuser.me/api/portraits/women/12.jpg"
                        displaySize="XS"
                        visible="{= ${roleModel>/isHR} === true || ${roleModel>/isEmployee} === true }"/>
                    <Button
                        icon="sap-icon://log"
                        type="Transparent"
                        press="onLogout"
                        tooltip="{i18n>tooltipLogout}"
                        visible="{= ${roleModel>/isHR} === true || ${roleModel>/isEmployee} === true }"/>
                </tnt:ToolHeader>
            </tnt:header>
            
            <tnt:sideContent>
                <tnt:SideNavigation
                    id="idSideNavigation"
                    itemSelect="onItemSelect"
                    visible="{= ${roleModel>/isHR} === true || ${roleModel>/isEmployee} === true }">
                    <tnt:NavigationList>
                        <tnt:NavigationListItem
                            text="{i18n>navDashboard}"
                            icon="sap-icon://grid"
                            key="RouteDashboard"
                            visible="{roleModel>/isHR}"/>
                        <tnt:NavigationListItem
                            text="{i18n>navEmployees}"
                            icon="sap-icon://group"
                            key="RouteEmployees"
                            visible="{roleModel>/isHR}"/>
                        <tnt:NavigationListItem
                            text="{i18n>navAttendance}"
                            icon="sap-icon://time-entry-request"
                            key="RouteAttendance"
                            visible="{roleModel>/isHR}"/>
                        <tnt:NavigationListItem
                            text="{i18n>navLeaveRequests}"
                            icon="sap-icon://person-placeholder"
                            key="RouteLeaves"
                            visible="{roleModel>/isHR}"/>
                        <tnt:NavigationListItem
                            text="{i18n>navDocuments}"
                            icon="sap-icon://document"
                            key="RouteDocuments"
                            visible="{roleModel>/isHR}"/>
                        <tnt:NavigationListItem
                            text="{i18n>navMyDashboard}"
                            icon="sap-icon://grid"
                            key="RouteEmployeeDashboard"
                            visible="{roleModel>/isEmployee}"/>
                        <tnt:NavigationListItem
                            text="{i18n>navMyProfile}"
                            icon="sap-icon://employee-lookup"
                            key="RouteProfile"
                            visible="{roleModel>/isEmployee}"/>
                        <tnt:NavigationListItem
                            text="{i18n>navMyAttendance}"
                            icon="sap-icon://time-entry-request"
                            key="RouteEmpAttendance"
                            visible="{roleModel>/isEmployee}"/>
                        <tnt:NavigationListItem
                            text="{i18n>navMyTasks}"
                            icon="sap-icon://task"
                            key="RouteTasks"
                            visible="{roleModel>/isEmployee}"/>
                        <tnt:NavigationListItem
                            text="{i18n>navMyDocuments}"
                            icon="sap-icon://upload-to-cloud"
                            key="RouteEmpDocuments"
                            visible="{roleModel>/isEmployee}"/>
                    </tnt:NavigationList>
                </tnt:SideNavigation>
            </tnt:sideContent>
            
            <tnt:mainContents>
                <App id="appId"/>
            </tnt:mainContents>
            
        </tnt:ToolPage>
    </Shell>
</mvc:View>