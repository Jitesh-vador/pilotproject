<mvc:View
    controllerName="com.hr.portal.controller.EmpAttendance"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page
        title="Employee Attendance"
        showHeader="true">
        <content>
            <!-- Header Bar -->
            <Bar>
                <contentLeft>
                    <Title text="HR Portal - Attendance"/>
                </contentLeft>
                <contentRight>
                    <Button
                        text="Submit Leave Request"
                        type="Emphasized"
                        press="onOpenLeaveDialog"/>
                </contentRight>
            </Bar>
            <!-- Attendance Table -->
            <Table
                id="idAttendanceTable"
                items="{HRModel>/PersonalRecords}">
                <headerToolbar>
                    <Toolbar>
                        <Title text="My Attendance Records"/>
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="Date"/>
                    </Column>
                    <Column>
                        <Text text="Status"/>
                    </Column>
                    <Column>
                        <Text text="Check In"/>
                    </Column>
                    <Column>
                        <Text text="Check Out"/>
                    </Column>
                    <Column>
                        <Text text="Total Hours"/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{HRModel>Date}"/>
                            <Text text="{HRModel>Status}"/>
                            <Text text="{HRModel>CheckIn}"/>
                            <Text text="{HRModel>CheckOut}"/>
                            <Text text="{HRModel>TotalHours}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            <!-- Leave Dialog -->
            <Dialog
                id="idLeaveDialog"
                title="Submit Leave Request"
                contentWidth="400px">
                <content>
                    <VBox
                        class="sapUiSmallMargin">
                        <Label
                            text="Leave Type"
                            required="true"/>
                        <Input
                            id="idLeaveType"
                            placeholder="e.g. Sick, Vacation"
                            valueLiveUpdate="true"/>
                        <Label
                            text="Date Range"
                            required="true"/>
                        <Input
                            id="idLeaveDate"
                            placeholder="e.g. May 10 - May 12"
                            valueLiveUpdate="true"/>
                        <Label
                            text="Reason"
                            required="true"/>
                        <TextArea
                            id="idLeaveReason"
                            width="100%"
                            rows="3"
                            placeholder="Enter reason for leave"/>
                    </VBox>
                </content>
                <beginButton>
                    <Button
                        text="Submit"
                        type="Emphasized"
                        press="onSubmitLeave"/>
                </beginButton>
                <endButton>
                    <Button
                        text="Cancel"
                        press="onCancelLeave"/>
                </endButton>
            </Dialog>
        </content>
    </Page>
</mvc:View>