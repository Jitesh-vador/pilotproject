<mvc:View
    controllerName="com.hr.portal.controller.Profile"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core">
    
    <Page showHeader="false" backgroundDesign="Transparent">
        <content>
            <VBox class="sapUiMediumMargin">
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                    <VBox>
                        <Title text="My Profile" level="H1" titleStyle="H3" class="mainHeaderTitle" />
                        <Text text="View and manage your profile information" class="subText" />
                    </VBox>
                    <HBox>
                        <Button text="Edit Profile" icon="sap-icon://edit" press=".onEditPress" visible="{viewMode>/readMode}" class="sapUiTinyMarginEnd" />
                        <Button text="Save Changes" type="Emphasized" icon="sap-icon://save" press=".onSavePress" visible="{viewMode>/editMode}" />
                    </HBox>
                </HBox>

                <HBox justifyContent="SpaceBetween" alignItems="Stretch" class="sapUiMediumMarginBottom">
                    <VBox width="31%" class="whiteSectionCard sapUiContentPadding" alignItems="Center" justifyContent="Center">
                        <Avatar src="{/Personal/Photo}" displaySize="XL" class="sapUiMediumMarginBottom" />
                        
                        <Title text="{/Personal/FullName}" level="H2" class="boldText sapUiSmallMarginBottom" visible="{viewMode>/readMode}" />
                        <Input value="{/Personal/FullName}" visible="{viewMode>/editMode}" class="sapUiSmallMarginBottom" textAlign="Center" />
                        
                        <Text text="{/Personal/Email}" class="subText sapUiSmallMarginBottom" visible="{viewMode>/readMode}" />
                        
                        <ObjectStatus text="Employee" state="None" inverted="true" class="roleBadge" />
                    </VBox>

                    <VBox width="67%" class="whiteSectionCard sapUiContentPadding">
                        <Title text="Personal Information" titleStyle="H4" class="sapUiSmallMarginBottom" />
                        
                        <VBox class="infoFieldGroup sapUiSmallMarginBottom">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://email" class="sapUiSmallMarginEnd" />
                                <VBox width="100%">
                                    <Label text="Email" class="subTextSmall" />
                                    <Text text="{/Personal/Email}" class="boldText" visible="{viewMode>/readMode}" />
                                    <Input value="{/Personal/Email}" visible="{viewMode>/editMode}" width="100%" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox class="infoFieldGroup sapUiSmallMarginBottom">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://business-card" class="sapUiSmallMarginEnd" />
                                <VBox width="100%">
                                    <Label text="Position" class="subTextSmall" />
                                    <Text text="{/Personal/Position}" class="boldText" visible="{viewMode>/readMode}" />
                                    <Input value="{/Personal/Position}" visible="{viewMode>/editMode}" width="100%" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox class="infoFieldGroup">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://building" class="sapUiSmallMarginEnd" />
                                <VBox width="100%">
                                    <Label text="Department" class="subTextSmall" />
                                    <Text text="{/Personal/Department}" class="boldText" visible="{viewMode>/readMode}" />
                                    <Input value="{/Personal/Department}" visible="{viewMode>/editMode}" width="100%" />
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox justifyContent="SpaceBetween">
                    <VBox width="32%" class="whiteSectionCard sapUiContentPadding">
                        <Title text="Leave Statistics" titleStyle="H4" class="sapUiSmallMarginBottom" />
                        <VBox class="sapUiSmallMarginBottom">
                            <Label text="Total Leave Requests" />
                            <Title text="{/Stats/TotalLeaves}" titleStyle="H3" />
                        </VBox>
                        <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                            <Text text="Approved" />
                            <Text text="{/Stats/Approved}" class="statusSuccessText" />
                        </HBox>
                        <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                            <Text text="Pending" />
                            <Text text="{/Stats/Pending}" class="statusWarningText" />
                        </HBox>
                        <HBox justifyContent="SpaceBetween">
                            <Text text="Rejected" />
                            <Text text="{/Stats/Rejected}" class="statusErrorText" />
                        </HBox>
                    </VBox>

                    <VBox width="32%" class="whiteSectionCard sapUiContentPadding">
                        <Title text="Performance" titleStyle="H4" class="sapUiSmallMarginBottom" />
                        <Label text="Total Ratings" />
                        <Title text="{/Stats/PerformanceRatings}" titleStyle="H3" />
                    </VBox>

                    <VBox width="32%" class="whiteSectionCard sapUiContentPadding">
                        <Title text="Account Status" titleStyle="H4" class="sapUiSmallMarginBottom" />
                        <VBox class="sapUiSmallMarginBottom">
                            <Label text="Role" />
                            <Text text="Employee" class="boldText" />
                        </VBox>
                        <VBox class="sapUiSmallMarginBottom">
                            <Label text="Status" />
                            <ObjectStatus text="Active" state="Success" inverted="true" />
                        </VBox>
                        <VBox>
                            <Label text="Member Since" />
                            <Text text="{/Personal/JoinDate}" />
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>