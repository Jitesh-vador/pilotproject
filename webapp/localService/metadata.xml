<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx
    Version="1.0"
    xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx">
    <edmx:DataServices
        m:DataServiceVersion="2.0"
        xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
        <Schema
            Namespace="com.hr.portal"
            xmlns="http://schemas.microsoft.com/ado/2008/09/edm">
            <!-- Personal Record Entity Type -->
            <EntityType Name="PersonalRecord">
                <Key>
                    <PropertyRef Name="Date"/>
                </Key>
                <Property Name="Date"
                    Type="Edm.String"
                    Nullable="false"/>
                <Property Name="Status"
                    Type="Edm.String"
                    Nullable="false"/>
                <Property Name="CheckIn"
                    Type="Edm.String"
                    Nullable="true"/>
                <Property Name="CheckOut"
                    Type="Edm.String"
                    Nullable="true"/>
                <Property Name="TotalHours"
                    Type="Edm.String"
                    Nullable="true"/>
            </EntityType>
            <!-- Leave Request Entity Type -->
            <EntityType Name="LeaveRequest">
                <Key>
                    <PropertyRef Name="LeaveId"/>
                </Key>
                <Property Name="LeaveId"
                    Type="Edm.String"
                    Nullable="false"/>
                <Property Name="LeaveType"
                    Type="Edm.String"
                    Nullable="false"/>
                <Property Name="DateRange"
                    Type="Edm.String"
                    Nullable="false"/>
                <Property Name="Reason"
                    Type="Edm.String"
                    Nullable="true"/>
                <Property Name="Status"
                    Type="Edm.String"
                    Nullable="false"/>
            </EntityType>
            <!-- Entity Container -->
            <EntityContainer
                Name="HRServiceContainer"
                m:IsDefaultEntityContainer="true">
                <EntitySet
                    Name="PersonalRecords"
                    EntityType="com.hr.portal.PersonalRecord"/>
                <EntitySet
                    Name="LeaveRequests"
                    EntityType="com.hr.portal.LeaveRequest"/>
            </EntityContainer>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>